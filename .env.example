# Copy to .env for local development. Never commit .env (specification section 21.8).
#
# Values marked REQUIRED have no fallback: the process refuses to start without them,
# by design, so a missing secret can never be masked by a development default.

# --- REQUIRED ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
POSTGRES_DB=vsat_dev
POSTGRES_USER=vsat
POSTGRES_PASSWORD=vsat_local_dev

# --- Optional, with safe defaults -------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Production only ---------------------------------------------------------
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_ALLOWED_HOSTS=vsat.example.internal
# DJANGO_CSRF_TRUSTED_ORIGINS=https://vsat.example.internal
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_MAX_UPLOAD_BYTES=26214400
